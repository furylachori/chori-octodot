{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "chori-octodot implementation plan",
  "type": "object",
  "required": [
    "schema_version",
    "project",
    "plan_version",
    "created_at",
    "status",
    "authorizes_execution",
    "baseline",
    "architecture",
    "permissions",
    "review_policy",
    "gates",
    "wave_policy",
    "failure_semantics",
    "finite_validation",
    "public_evidence_policy",
    "license",
    "sources",
    "slices",
    "waves",
    "dependencies"
  ],
  "properties": {
    "schema_version": {
      "const": "chori-octodot.implementation-plan.v1"
    },
    "project": {},
    "plan_version": {},
    "created_at": {},
    "status": {
      "const": "planning_only"
    },
    "authorizes_execution": {
      "const": false
    },
    "baseline": {},
    "architecture": {},
    "permissions": {},
    "review_policy": {},
    "gates": {},
    "wave_policy": {},
    "failure_semantics": {},
    "finite_validation": {},
    "public_evidence_policy": {},
    "license": {},
    "sources": {},
    "slices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "status",
          "wave",
          "optional",
          "execution_mode",
          "depends_on",
          "allowed_files",
          "objective",
          "non_goals",
          "interfaces",
          "estimated_scope",
          "tests",
          "verification_commands",
          "entry_gates",
          "definition_of_done",
          "stop_conditions",
          "review_policy"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^S[0-9]{2}$"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "const": "planned"
          },
          "execution_mode": {
            "enum": [
              "offline",
              "live_read_only",
              "live_mutation"
            ]
          },
          "objective": {
            "type": "string"
          },
          "review_policy": {
            "type": "string"
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "allowed_files": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "non_goals": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "interfaces": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "verification_commands": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "entry_gates": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "definition_of_done": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "stop_conditions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "wave": {
            "type": "integer",
            "minimum": 0
          },
          "optional": {
            "type": "boolean"
          },
          "estimated_scope": {
            "type": "object",
            "required": [
              "engineering_days",
              "basis"
            ],
            "properties": {
              "engineering_days": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "basis": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "tests": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "case",
                "required",
                "kind"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "case": {
                  "type": "string"
                },
                "required": {
                  "const": true
                },
                "kind": {
                  "enum": [
                    "offline",
                    "live_acceptance"
                  ]
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "waves": {},
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
