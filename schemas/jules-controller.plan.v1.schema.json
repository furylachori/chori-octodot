{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://octodot.org/schemas/jules-controller.plan.v1.schema.json",
  "title": "Jules Controller Plan Schema v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "plan_hash",
    "profile",
    "execution",
    "scope",
    "limits",
    "actions",
    "output"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "jules-controller.plan.v1"
    },
    "plan_id": {
      "type": "string",
      "minLength": 1
    },
    "plan_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "profile": {
      "type": "string",
      "minLength": 1
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["read_only", "authorized_get", "mutation"]
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository"],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "branch": {
          "type": "string"
        },
        "sessions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deadline_seconds",
        "request_timeout_seconds",
        "max_http_requests",
        "max_posts",
        "max_pages",
        "max_sessions",
        "max_response_bytes",
        "max_total_bytes",
        "max_output_bytes"
      ],
      "properties": {
        "deadline_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "request_timeout_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "max_http_requests": {
          "type": "integer",
          "minimum": 0
        },
        "max_posts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "max_pages": {
          "type": "integer",
          "minimum": 1
        },
        "max_sessions": {
          "type": "integer",
          "minimum": 1
        },
        "max_response_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "max_total_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "max_output_bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "op"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "op": {
            "type": "string",
            "enum": [
              "inventory.collect",
              "session.inspect",
              "chats.collect",
              "chats.reply",
              "tasks.create",
              "plans.approve",
              "suggestions.collect",
              "artifacts.export_patch",
              "publication.verify",
              "operations.reconcile",
              "events.read",
              "events.ack",
              "wait",
              "capabilities.inspect",
              "healthcheck"
            ]
          },
          "params": {
            "type": "object"
          },
          "enabled": {
            "type": "boolean"
          },
          "operation_id": {
            "type": "string",
            "minLength": 1
          },
          "authorization_ref": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": ["string", "object"]
          },
          "payload": {
            "type": "object"
          },
          "preconditions": {
            "type": "object"
          }
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format"],
      "properties": {
        "format": {
          "type": "string",
          "enum": ["json", "summary"]
        },
        "destination": {
          "type": "string"
        }
      }
    }
  }
}
